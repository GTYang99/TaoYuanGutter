<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="點位"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/textColorSecondary"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp">

            <Spinner
                android:id="@+id/spinnerPointSelector"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_inspect_field"
                android:paddingStart="12dp"
                android:paddingEnd="40dp"
                android:gravity="center_vertical|start" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_dropdown_arrow"
                android:contentDescription="@null" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="測量位置及側溝概況"
            android:textSize="14sp"
            android:textColor="@color/textColorSecondary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_photo_placeholder"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <View
                android:id="@+id/ratioAnchor1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,4:3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/placeholderSlot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="@id/ratioAnchor1"
                app:layout_constraintBottom_toBottomOf="@id/ratioAnchor1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_camera"
                    android:alpha="0.3"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_photo"
                    android:textSize="12sp"
                    android:textColor="@color/inputFieldHint"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPhotoSlot1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="@id/ratioAnchor1"
                app:layout_constraintBottom_toBottomOf="@id/ratioAnchor1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="側溝內徑寬度尺寸"
            android:textSize="14sp"
            android:textColor="@color/textColorSecondary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_photo_placeholder"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <View
                android:id="@+id/ratioAnchor2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,4:3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/placeholderSlot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="@id/ratioAnchor2"
                app:layout_constraintBottom_toBottomOf="@id/ratioAnchor2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_camera"
                    android:alpha="0.3"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_photo"
                    android:textSize="12sp"
                    android:textColor="@color/inputFieldHint"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPhotoSlot2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="@id/ratioAnchor2"
                app:layout_constraintBottom_toBottomOf="@id/ratioAnchor2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="側溝深度尺寸"
            android:textSize="14sp"
            android:textColor="@color/textColorSecondary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_photo_placeholder"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <View
                android:id="@+id/ratioAnchor3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,4:3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/placeholderSlot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="@id/ratioAnchor3"
                app:layout_constraintBottom_toBottomOf="@id/ratioAnchor3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_camera"
                    android:alpha="0.3"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_photo"
                    android:textSize="12sp"
                    android:textColor="@color/inputFieldHint"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPhotoSlot3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="@id/ratioAnchor3"
                app:layout_constraintBottom_toBottomOf="@id/ratioAnchor3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
