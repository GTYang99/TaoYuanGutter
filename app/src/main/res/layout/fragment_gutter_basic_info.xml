<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="96dp">

        <!-- 虛擬模式下隱藏的區段 1 -->
        <LinearLayout
            android:id="@+id/llVirtualHidden1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ① 側溝編號 ─────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tilGutterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/field_gutter_id"
                android:textSize="13sp"
                android:textColor="@color/textColorSecondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGutterId"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxStrokeColor="@color/colorPrimary"
                app:boxBackgroundColor="@color/white">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGutterId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/textColorPrimary"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ② 側溝形式 ─────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/field_gutter_type"
                android:textSize="13sp"
                android:textColor="@color/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/layoutGutterTypeSelector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvGutterTypeSelector"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_inspect_field"
                    android:gravity="center_vertical|start"
                    android:paddingStart="12dp"
                    android:paddingEnd="40dp"
                    android:text="請選擇"
                    android:textColor="@color/inputFieldHint"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_dropdown_arrow"
                    android:contentDescription="@null" />

            </FrameLayout>

        </LinearLayout>

        <!-- ④ 側溝位置 ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="側溝位置"
            android:textSize="13sp"
            android:textColor="@color/textColorSecondary"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickLocation"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="編輯定位"
            android:textAllCaps="false"
            android:textColor="@color/text_grey"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp"
            app:iconPadding="6dp"
            app:strokeColor="@color/map_borders_grey"
            app:strokeWidth="1dp"
            />

        <LinearLayout
            android:id="@+id/layoutOverviewPhotoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photo_slot_overview"
                    android:textSize="14sp"
                    android:textColor="@color/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhotoTime1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary"
                    android:visibility="gone" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakePhotoSlot1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="拍攝照片"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@color/colorBgTitle"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPrimaryLight2"
                app:strokeWidth="1dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/photoSlot1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_photo_placeholder"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <View
                    android:id="@+id/ratioAnchor1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="H,4:3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/placeholderSlot1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor1"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="centerInside"
                        android:alpha="0.6"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_take_photo"
                        android:textSize="12sp"
                        android:textColor="@color/inputFieldHint"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivPhotoSlot1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor1"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/pbPhotoLoading1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:visibility="gone"
                    android:indeterminate="true"
                    android:elevation="12dp"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="@android:color/transparent"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor1"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/btnDeleteSlot1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/colorPrimary"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:background="@drawable/bg_delete_btn"
                    android:visibility="gone"
                    android:contentDescription="@null"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- 虛擬模式下隱藏的區段 2 -->
        <LinearLayout
            android:id="@+id/llVirtualHidden2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ⑤ 側溝Z座標 ─────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvCoordZTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/field_coord_z"
                android:textSize="13sp"
                android:textColor="@color/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCoordZ"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxStrokeColor="@color/colorPrimary"
                app:boxBackgroundColor="@color/white">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCoordZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned"
                    android:textColor="@color/textColorPrimary"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ⑥ 測量座標編號 ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/field_measure_id"
                android:textSize="13sp"
                android:textColor="@color/textColorSecondary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/btnPendingDeploy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonTint="?attr/colorPrimary"
                android:text="@string/btn_pending_deploy" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMeasureId"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="false"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxBackgroundColor="@color/white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMeasureId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorPrimary"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ⑦ 溝蓋板厚度 (保留欄位，僅受明溝或無法開蓋邏輯控制遮罩) ──────── -->
        <LinearLayout
            android:id="@+id/llCoverThicknessWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/field_cover_thickness_cm"
                    android:textSize="13sp"
                    android:textColor="@color/textColorSecondary" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbCantOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonTint="@color/colorPrimary"
                    android:text="@string/field_cannot_open" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/flCoverThicknessContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCoverThickness"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:boxBackgroundColor="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCoverThickness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:digits="0123456789"
                        android:textColor="@color/textColorPrimary"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 半透明白色遮罩層：樣式與「無法開蓋」勾選後的視覺效果保持一致 -->
                <View
                    android:id="@+id/vCoverThicknessOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="16dp"
                    android:background="#80FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

        <!-- 虛擬模式下隱藏的區段 3 -->
        <LinearLayout
            android:id="@+id/llVirtualHidden3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 側溝頂寬度 ───────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/field_width_cm"
            android:textSize="13sp"
            android:textColor="@color/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTopWidth"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="false"
            app:helperTextEnabled="true"
            app:errorEnabled="true"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxBackgroundColor="@color/white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTopWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:digits="0123456789"
                android:textColor="@color/textColorPrimary"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/layoutWidthPhotoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_photo_width"
                    android:textSize="14sp"
                    android:textColor="@color/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhotoTime2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary"
                    android:visibility="gone" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakePhotoSlot2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="拍攝照片"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@color/colorBgTitle"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPrimaryLight2"
                app:strokeWidth="1dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/photoSlot2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_photo_placeholder"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <View
                    android:id="@+id/ratioAnchor2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="H,4:3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/placeholderSlot2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor2"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="centerInside"
                        android:alpha="0.6"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_take_photo"
                        android:textSize="12sp"
                        android:textColor="@color/inputFieldHint"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivPhotoSlot2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor2"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/pbPhotoLoading2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:visibility="gone"
                    android:indeterminate="true"
                    android:elevation="12dp"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="@android:color/transparent"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor2"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/btnDeleteSlot2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/colorPrimary"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:background="@drawable/bg_delete_btn"
                    android:visibility="gone"
                    android:contentDescription="@null"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- ⑧ 側溝測量深度 ──────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/field_depth_cm"
            android:textSize="13sp"
            android:textColor="@color/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDepth"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="false"
            app:helperTextEnabled="true"
            app:errorEnabled="true"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxBackgroundColor="@color/white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDepth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:digits="0123456789"
                android:textColor="@color/textColorPrimary"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/layoutDepthPhotoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_photo_depth"
                    android:textSize="14sp"
                    android:textColor="@color/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhotoTime3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary"
                    android:visibility="gone" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakePhotoSlot3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="拍攝照片"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@color/colorBgTitle"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPrimaryLight2"
                app:strokeWidth="1dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/photoSlot3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_photo_placeholder"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <View
                    android:id="@+id/ratioAnchor3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="H,4:3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/placeholderSlot3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor3"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="centerInside"
                        android:alpha="0.6"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_take_photo"
                        android:textSize="12sp"
                        android:textColor="@color/inputFieldHint"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivPhotoSlot3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor3"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/pbPhotoLoading3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:visibility="gone"
                    android:indeterminate="true"
                    android:elevation="12dp"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="@android:color/transparent"
                    app:layout_constraintTop_toTopOf="@id/ratioAnchor3"
                    app:layout_constraintBottom_toBottomOf="@id/ratioAnchor3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/btnDeleteSlot3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/colorPrimary"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:background="@drawable/bg_delete_btn"
                    android:visibility="gone"
                    android:contentDescription="@null"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>



        <!-- ③ 側溝材質 ─────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/field_gutter_material"
            android:textSize="13sp"
            android:textColor="@color/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgMatType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbMatType0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/material_concrete"
                android:buttonTint="@color/colorPrimary"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="20dp" />

            <RadioButton
                android:id="@+id/rbMatType1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/material_gravel"
                android:buttonTint="@color/colorPrimary"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="20dp" />

            <RadioButton
                android:id="@+id/rbMatType2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/material_brick"
