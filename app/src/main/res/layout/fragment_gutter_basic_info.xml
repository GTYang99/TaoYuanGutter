                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

        </RadioGroup>

        <!-- ⑨ 溝體結構受損 ──────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_broken"
            android:textSize="13sp"
            android:textColor="@color/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgIsBroken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbIsBroken0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/damage_no"
                android:buttonTint="@color/colorPrimary"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="32dp" />

            <RadioButton
                android:id="@+id/rbIsBroken1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/damage_yes"
                android:buttonTint="@color/colorPrimary"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

        </RadioGroup>

        <!-- ⑩ 附掛或過路管線 ─────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_hanging"
            android:textSize="13sp"
            android:textColor="@color/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgIsHanging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbIsHanging0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hanging_no"
                android:buttonTint="@color/colorPrimary"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="32dp" />

            <RadioButton
                android:id="@+id/rbIsHanging1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hanging_yes"
                android:buttonTint="@color/colorPrimary"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

        </RadioGroup>

        <!-- ⑪ 淤積程度 ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
