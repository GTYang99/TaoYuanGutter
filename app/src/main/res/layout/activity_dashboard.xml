<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
        <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_title" android:textColor="@color/black" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvError" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textColor="@color/colorOnCancel" />
        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginEnd="6dp" app:cardBackgroundColor="@color/dashboard_group_bg" app:cardCornerRadius="8dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_today_mileage" android:textColor="@color/dashboard_group_value" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:orientation="horizontal"><TextView android:id="@+id/todayValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/dashboard_group_value" android:textSize="22sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_km_unit" android:textColor="@color/dashboard_group_value" android:textSize="14sp" /></LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginStart="6dp" app:cardBackgroundColor="@color/dashboard_group_bg" app:cardCornerRadius="8dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_cumulative_mileage" android:textColor="@color/dashboard_group_value" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:orientation="horizontal"><TextView android:id="@+id/cumulativeValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/dashboard_group_value" android:textSize="22sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_km_unit" android:textColor="@color/dashboard_group_value" android:textSize="14sp" /></LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="8dp" app:strokeColor="@color/border_grey" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_search_title" android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/dashboard_date_range_subtitle" android:textColor="@color/dashboard_detail_label" android:textSize="14sp" />
                <TextView android:id="@+id/startDate" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="@string/dashboard_pick_start_date" android:textColor="@color/text_grey" android:textSize="16sp" android:background="@drawable/bg_dashboard_date_field" />
                <TextView android:id="@+id/endDate" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="@string/dashboard_pick_end_date" android:textColor="@color/text_grey" android:textSize="16sp" android:background="@drawable/bg_dashboard_date_field" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end"><com.google.android.material.button.MaterialButton android:id="@+id/clearButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="112dp" android:text="@string/dashboard_filter_clear" android:textSize="16sp" app:cornerRadius="8dp" app:strokeWidth="1dp" /><com.google.android.material.button.MaterialButton android:id="@+id/searchButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:minWidth="96dp" android:text="@string/dashboard_search" android:textColor="@color/white" android:textSize="16sp" app:backgroundTint="@color/colorPrimary" app:cornerRadius="8dp" /></LinearLayout>
                <TextView android:id="@+id/queryResultTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/dashboard_query_result" android:textColor="@color/dashboard_detail_label" android:textSize="14sp" />
                <LinearLayout android:id="@+id/searchResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="bottom" android:visibility="gone" android:padding="16dp" android:background="@drawable/bg_dashboard_result_card"><TextView android:id="@+id/searchResultValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/dashboard_group_value" android:textSize="24sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_km_unit" android:textColor="@color/dashboard_detail_label" android:textSize="14sp" /></LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
