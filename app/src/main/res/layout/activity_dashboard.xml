idth="1dp" /><com.google.android.material.button.MaterialButton android:id="@+id/searchButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:minWidth="96dp" android:text="@string/dashboard_search" android:textSize="16sp" app:cornerRadius="8dp" app:backgroundTint="@color/colorPrimary" android:textColor="@color/white" /></LinearLayout><LinearLayout android:id="@+id/searchResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone" android:padding="16dp" android:background="@drawable/bg_dashboard_result_card"><TextView android:id="@+id/searchResultValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dashboard_group_value" android:textSize="24sp" android:textStyle="bold" /></LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
