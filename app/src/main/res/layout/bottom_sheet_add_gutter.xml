<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_form_sheet"
        android:orientation="vertical">

    <!-- Drag Handle -->

        <!-- Header Row: [<] 新增側溝 [+] -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="4dp">

        <!-- 關閉按鈕（左，返回箭頭，一般模式） -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="關閉"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_grey" />

        <!-- 取消按鈕（左，文字，離線模式，預設 GONE） -->
        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:text="@string/cancel"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="btnClose,tvCancel" />

        <!-- 標題 -->
        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/btn_add_gutter"
            android:textColor="@color/text_grey"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 新增節點按鈕（右） -->
        <ImageButton
            android:id="@+id/btnAddNode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/form_finish_button"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorPrimary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 分隔線 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_grey" />

    <!-- 側溝類型切換列 -->
    <LinearLayout
        android:id="@+id/layoutGutterType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F7"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:orientation="horizontal">

        <RadioGroup
            android:id="@+id/rgGutterKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioButton
                android:id="@+id/rbKindNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一般側溝"
                android:textSize="15sp"
                android:textColor="@color/text_grey"
                android:buttonTint="@color/colorPrimary"
                android:checked="true"
                android:paddingEnd="24dp" />

            <RadioButton
                android:id="@+id/rbKindCurve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="弧線側溝"
                android:textSize="15sp"
                android:textColor="@color/text_grey"
                android:buttonTint="@color/colorPrimary"
                android:paddingEnd="24dp" />

        </RadioGroup>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvGutterTypeTitle"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:text="@string/field_gutter_type"
                android:textColor="@color/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvGutterTypeRequired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="*"
                android:textColor="#7B4FFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/layoutGutterTypeSelector"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvGutterTypeSelector"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_inspect_field"
                android:gravity="center_vertical|start"
                android:paddingStart="12dp"
                android:paddingEnd="40dp"
                android:text="請選擇"
                android:textColor="@color/inputFieldHint"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_dropdown_arrow"
                android:contentDescription="@null" />

        </FrameLayout>
    </LinearLayout>

    <!-- 節點清單（佔剩餘空間） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWaypoints"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- 底部分隔線 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_grey" />

    <!-- 底部按鈕列：新增模式只顯示「新增側溝」（全寬）；
         編輯模式左側「刪除側溝」＋右側「更新側溝」並排 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 調轉按鈕 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReverse"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="14dp"
                android:visibility="gone"
                app:backgroundTint="#F5F5F7"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_swap_vert"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/colorPrimary"
                app:strokeWidth="0dp" />

            <!-- 刪除側溝按鈕（編輯模式顯示，預設 GONE） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteGutter"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_delete_gutter"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#D32F2F"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp" />

            <!-- 新增／更新側溝按鈕 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitGutter"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_add_gutter"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/msg_loading_waypoint_data"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
