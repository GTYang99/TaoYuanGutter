<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 只允許內部測試伺服器走 HTTP，其餘流量維持預設 HTTPS 限制 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.10.84</domain>
    </domain-config>

    <!-- release/debug 都只針對 demo.srgeo.com.tw 額外信任此 CA，避免放大信任範圍 -->
    <domain-config>
        <domain includeSubdomains="true">demo.srgeo.com.tw</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/cacert" />
            <certificates src="@raw/chunghwa_telecom_gcc_r46_ov_tls_ca_2025" />
        </trust-anchors>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
            <certificates src="@raw/cacert" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
